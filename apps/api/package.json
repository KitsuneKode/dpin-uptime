{
  "name": "@dpin-uptime/api",
  "module": "./src/server.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "check-types": "tsc -noEmit",
    "build": "bun build ./src/server.ts --outdir ./dist --target bun --minify --sourcemap",
    "dev": "bun run --watch src/server.ts",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "start": "bun run dist/server.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "devDependencies": {
    "@dpin-uptime/typescript-config": "*",
    "@types/bun": "^1.3.2",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.5"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@dpin-uptime/common": "*",
    "@dpin-uptime/auth": "*",
    "@dpin-uptime/store": "*",
    "cors": "^2.8.5",
    "express": "^5.1.0"
  }
}
