{
  "name": "@dpin-uptime/hub",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "check-types": "tsc -noEmit",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --minify --sourcemap",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run dist/index.js",
    "lint": "eslint .",
    "lint:fix": "eslint --fix ."
  },
  "devDependencies": {
    "@types/bun": "^1.3.2",
    "@dpin-uptime/typescript-config": "*"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@dpin-uptime/auth": "*",
    "@dpin-uptime/common": "*",
    "@solana/web3.js": "^1.98.4",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  }
}
