{
  "name": "@dpin-uptime/validator",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "scripts": {
    "check-types": "tsc -noEmit",
    "build": "bun build ./src/index.ts --outdir ./dist --target bun --minify --sourcemap",
    "dev": "bun run --watch src/index.ts",
    "start": "bun run dist/index.js",
    "lint": "bun run lint"
  },
  "dependencies": {
    "@dpin-uptime/common": "*",
    "@solana/web3.js": "^1.95.0",
    "bs58": "^6.0.0",
    "tweetnacl": "^1.0.3",
    "tweetnacl-util": "^0.15.1"
  },
  "devDependencies": {
    "@dpin-uptime/typescript-config": "*",
    "@types/bs58": "^5.0.0",
    "@types/bun": "^1.3.2"
  },
  "peerDependencies": {
    "typescript": "^5.9.3"
  }
}
